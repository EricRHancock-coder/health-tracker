{
    "name": "health-tracker/backend",
    "description": "Backend for Health Tracker application",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "firebase/php-jwt": "^6.0",
        "gabordemooij/redbean": "^5.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "./"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "audit": {
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        }
    }
}
